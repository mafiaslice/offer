# Copy to .env.local. Do not put real secrets in this file or in git.

# Public site URL (used for auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for production auth + Postgres)
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Prefer anon key + RLS. Only set this for admin/scripts, never expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Phone OTP needs Twilio on the Supabase project. Leave unset to keep SMS gated in the UI.
# NEXT_PUBLIC_SUPABASE_SMS_AUTH=true

# Payments are not implemented — paid gigs store incentive text only.
# PAYMENTS_PROVIDER=
