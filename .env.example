# Copy to .env.local. Do not put real secrets in this file or in git.

# Railway Postgres connection string. When unset, the app uses the in-repo demo adapter.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/offer

# Signs session cookies. Required whenever DATABASE_URL is set.
# Generate with: openssl rand -base64 32
# AUTH_SECRET=

# Optional. Signs /check-in/[token] payloads. Demo and local builds use a fixed fallback.
# CHECK_IN_SECRET=

# Optional. Local `next start` is production mode. Set false so the session cookie works over http://localhost.
# Leave unset on Railway (HTTPS). AUTH_COOKIE_SECURE defaults to true when NODE_ENV=production.
# AUTH_COOKIE_SECURE=false

# Optional seed host, used only by `npm run seed:demo` when the database has no profiles.
# SEED_HOST_EMAIL=seed-host@offer.local
# SEED_HOST_PASSWORD=

# Payments are not implemented — paid gigs store incentive text only.
# PAYMENTS_PROVIDER=
